import wollok.game.*
import jugador.*
import controladorDeNivel.*
import controladorDePantallas.*
import niveles.*
import hud.*
import proyectiles.*
import musica.*
import estadosJuego.*
import juego.*
import mapa.*
import enemigos.*

describe "Testeos de Enemigos" {

  test "1. jugador inicia con 3 vidas" {
    assert.equals(3, jugador.vidas())
  }

  test "2. jugador puede moverse de posición" {
    const posicionInicial = jugador.position()
    jugador.position(game.at(6, 2))
    assert.notEquals(posicionInicial, jugador.position())
  }

  test "3. jugador puede cambiar su imagen" {
    jugador.image("jugadorBase.png")
    jugador.image("jugadorPotenciado.png")
    assert.equals("jugadorPotenciado.png", jugador.image())
  }

  test "4. jugador pierde vida al recibir daño" {
    jugador.vidas(3)
    jugador.recibirDanio(1)
    assert.equals(2, jugador.vidas())
  }

  test "5. jugador muere al recibir daño suficiente" {
    jugador.vidas(3)
    jugador.recibirDanio(3)
    assert.equals(0, jugador.vidas())
  }

  test "6. jugador suma puntos correctamente" {
    jugador.puntos(0)
    jugador.sumarPuntos(100)
    assert.equals(100, jugador.puntos())
  }

  test "7. jugador acumula puntos en distintos llamados" {
    jugador.puntos(0)
    jugador.sumarPuntos(200)
    jugador.sumarPuntos(300)
    assert.equals(500, jugador.puntos())
  }

  test "8. jugador puede cambiar de imagen correctamente" {
    jugador.image("jugadorBase.png")
    jugador.image("jugadorPotenciado.png")
    assert.equals("jugadorPotenciado.png", jugador.image())
  }

  test "9. jugador puede ganar varias vidas" {
    jugador.vidas(3)
    jugador.vidas(jugador.vidas() + 2)
    assert.equals(5, jugador.vidas())
  }

  test "10. jugador puede perder todas sus vidas" {
    jugador.vidas(3)
    jugador.recibirDanio(3)
    assert.equals(0, jugador.vidas())
  }

  test "11. jugador acumula puntos al eliminar enemigos" {
    jugador.puntos(0)
    jugador.sumarPuntos(100)
    jugador.sumarPuntos(50)
    assert.equals(150, jugador.puntos())
  }

  test "12. jugador puede activar y desactivar inmunidad" {
    jugador.inmune(false)
    assert.equals(false, jugador.inmune())
    jugador.inmune(true)
    assert.equals(true, jugador.inmune())
  }

  test "13. enemigo pierde vida al recibir daño" {
    const enemigo = new Enemigo(vidas = 3, danio = 1, position = game.origin(), image = "enemigo.png")
    enemigo.recibirDanio(1)
    assert.that(enemigo.vidas() == 2)
  }

  test "14. enemigo muere al recibir daño suficiente" {
    const enemigo = new Enemigo(vidas = 2, danio = 1, position = game.origin(), image = "enemigo.png")
    enemigo.recibirDanio(2)
    assert.that(enemigo.vidas() <= 0)
  }

  test "15. enemigo común empieza con 1 vida" {
    const enemigo = new Enemigo(position = game.at(1,1))
    assert.equals(1, enemigo.vidas())
  }

  test "16. enemigo común pierde vida al recibir daño" {
    const enemigo = new Enemigo(position = game.at(1,1))
    enemigo.recibirDanio(1)
    assert.equals(0, enemigo.vidas())
  }

  test "17. enemigo común hace daño al jugador" {
    const enemigo = new Enemigo(position = game.at(1,1))
    jugador.vidas(3)
    enemigo.interactuarConJugador(jugador)
    assert.equals(2, jugador.vidas())
  }

  test "18. enemigo común no cambia al chocar con otro enemigo" {
    const enemigo = new Enemigo(position = game.at(1,1))
    const otro = new Enemigo(position = game.at(2,2))
    enemigo.interactuarConEnemigo(otro)
    assert.equals(1, enemigo.vidas())
  }

  test "19. enemigo común muere con un golpe" {
    const enemigoComun = new Enemigo(position = game.at(1,1))
    enemigoComun.recibirDanio(1)
    assert.equals(0, enemigoComun.vidas())
  }

  test "20. enemigo común tiene una imagen asignada" {
    const enemigoComun = new Enemigo(position = game.at(1,1))
    assert.equals(true, enemigoComun.image() != null && enemigoComun.image() != "")
  }

  test "21. enemigo pesado tiene 2 vidas al crearse" {
    const enemigoPesado = new EnemigoPesado(position = game.at(2,2))
    assert.equals(2, enemigoPesado.vidas())
  }

  test "22. enemigo pesado sobrevive al primer golpe" {
    const enemigoPesado = new EnemigoPesado(position = game.at(2,2))
    enemigoPesado.recibirDanio(1)
    assert.equals(1, enemigoPesado.vidas())
  }

  test "23. enemigo pesado muere al segundo golpe" {
    const enemigoPesado = new EnemigoPesado(position = game.at(2,2))
    enemigoPesado.recibirDanio(2)
    assert.equals(0, enemigoPesado.vidas())
  }

  test "24. enemigo pesado inflige más daño que el común" {
    const enemigoComun = new Enemigo(position = game.at(1,1))
    const enemigoPesado = new EnemigoPesado(position = game.at(2,2))
    assert.equals(true, enemigoPesado.danio() > enemigoComun.danio())
  }

  test "25. enemigo pesado sobrevive más tiempo" {
    const enemigoPesado = new EnemigoPesado(position = game.at(2,2))
    enemigoPesado.recibirDanio(1)
    assert.equals(true, enemigoPesado.vidas() > 0)
  }

  test "26. jefe tiene 10 vidas al iniciar" {
    jefe.vidas(10)
    assert.equals(10, jefe.vidas())
  }

  test "27. jefe pierde vida al recibir daño" {
    jefe.vidas(10)
    jefe.recibirDanio(3)
    assert.equals(7, jefe.vidas())
  }

  test "28. jefe cambia posición al moverse" {
    jefe.position(game.at(3,3))
    const posInicial = jefe.position()
    jefe.movimiento()
    assert.notEquals(posInicial, jefe.position())
  }

  test "29. jefe se mueve al ejecutar movimiento" {
    jefe.position(game.at(0,0))
    const posicionInicial = jefe.position()
    jefe.movimiento()
    assert.notEquals(posicionInicial, jefe.position())
  }

  test "30. jefe tiene más vidas que el enemigo pesado" {
    const enemigoPesado = new EnemigoPesado(position = game.at(2,2))
    assert.equals(true, jefe.vidas() > enemigoPesado.vidas())
  }
}