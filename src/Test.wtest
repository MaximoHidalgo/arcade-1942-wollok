// =============================================================================
// SUITE DE PRUEBAS UNITARIAS: ARCADE 1942 (WOLLOK GAME)
// =============================================================================

describe "Módulo 1: Jugador - Estado, Movimiento, Salud e Inmunidad" {

  test "1. jugador inicia con 3 vidas por defecto" {
    assert.equals(3, jugador.vidas())
  }

  test "2. jugador puede desplazarse en la grilla espacial" {
    const posicionInicial = jugador.position()
    jugador.position(game.at(6, 2))
    assert.notEquals(posicionInicial, jugador.position())
  }

  test "3. jugador actualiza correctamente su sprite visual" {
    jugador.image("jugadorBase.png")
    jugador.image("jugadorIzqu.png")
    assert.equals("jugadorIzqu.png", jugador.image())
  }

  test "4. jugador pierde vidas de forma consistente al recibir daño" {
    jugador.inmune(false)
    jugador.vidas(3)
    jugador.recibirDanio(1)
    assert.equals(2, jugador.vidas())
  }

  test "5. jugador alcanza estado de muerte cuando las vidas llegan a 0" {
    jugador.inmune(false)
    jugador.vidas(3)
    jugador.recibirDanio(3)
    assert.equals(0, jugador.vidas())
  }

  test "6. jugador incrementa su puntuación al derribar objetivos" {
    jugador.puntos(0)
    jugador.sumarPuntos(100)
    assert.equals(100, jugador.puntos())
  }

  test "7. jugador acumula puntaje en sucesivas rachas de combate" {
    jugador.puntos(0)
    jugador.sumarPuntos(200)
    jugador.sumarPuntos(300)
    assert.equals(500, jugador.puntos())
  }

  test "8. jugador puede alterar dinámicamente su sprite a estado potenciado" {
    jugador.image("jugadorBase.png")
    jugador.image("jugadorPotenciado.png")
    assert.equals("jugadorPotenciado.png", jugador.image())
  }

  test "9. jugador puede recuperar o incrementar vidas" {
    jugador.vidas(3)
    jugador.vidas(jugador.vidas() + 2)
    assert.equals(5, jugador.vidas())
  }

  test "10. jugador en estado inmune NO pierde vidas al recibir impacto" {
    jugador.vidas(3)
    jugador.inmune(true)
    jugador.recibirDanio(1)
    assert.equals(3, jugador.vidas())
  }

  test "11. desactivar inmunidad permite que el jugador vuelva a recibir daño" {
    jugador.vidas(3)
    jugador.inmune(false)
    jugador.recibirDanio(1)
    assert.equals(2, jugador.vidas())
  }

  test "12. jugador conmuta y valida correctamente el flag de inmunidad" {
    jugador.inmune(false)
    assert.equals(false, jugador.inmune())
    jugador.inmune(true)
    assert.equals(true, jugador.inmune())
  }
}

describe "Módulo 2: Enemigos - Jerarquías, Resistencia y Puntuación" {

  test "13. enemigo común inicia con 1 vida por defecto" {
    const enemigo = new Enemigo(position = game.at(1, 1))
    assert.equals(1, enemigo.vidas())
  }

  test "14. enemigo común reduce vidas al recibir impacto" {
    const enemigo = new Enemigo(position = game.at(1, 1))
    enemigo.recibirDanio(1)
    assert.equals(0, enemigo.vidas())
  }

  test "15. enemigo común inflige daño al colisionar con el jugador" {
    const enemigo = new Enemigo(position = game.at(1, 1))
    jugador.inmune(false)
    jugador.vidas(3)
    enemigo.interactuarConJugador(jugador)
    assert.equals(2, jugador.vidas())
  }

  test "16. colisión entre dos enemigos aliados es inocua y no resta vidas" {
    const enemigo = new Enemigo(position = game.at(1, 1))
    const otro = new Enemigo(position = game.at(2, 2))
    enemigo.interactuarConEnemigo(otro)
    assert.equals(1, enemigo.vidas())
  }

  test "17. enemigo común posee sprite asignado válidamente" {
    const enemigo = new Enemigo(position = game.at(1, 1))
    assert.that(enemigo.image() != null && enemigo.image() != "")
  }

  test "18. enemigo pesado inicia con 2 vidas por herencia" {
    const enemigoPesado = new EnemigoPesado(position = game.at(2, 2))
    assert.equals(2, enemigoPesado.vidas())
  }

  test "19. enemigo pesado sobrevive al primer impacto" {
    const enemigoPesado = new EnemigoPesado(position = game.at(2, 2))
    enemigoPesado.recibirDanio(1)
    assert.equals(1, enemigoPesado.vidas())
  }

  test "20. enemigo pesado es destruido tras el segundo impacto" {
    const enemigoPesado = new EnemigoPesado(position = game.at(2, 2))
    enemigoPesado.recibirDanio(2)
    assert.equals(0, enemigoPesado.vidas())
  }

  test "21. enemigo pesado inflige mayor daño que el caza común" {
    const enemigoComun = new Enemigo(position = game.at(1, 1))
    const enemigoPesado = new EnemigoPesado(position = game.at(2, 2))
    assert.that(enemigoPesado.danio() > enemigoComun.danio())
  }

  test "22. enemigo detecta cuando sobrepasa los límites del mapa" {
    const enemigoFuera = new Enemigo(position = game.at(1, -1))
    assert.that(enemigoFuera.comprobarLimiteMapa())
    const enemigoDentro = new Enemigo(position = game.at(1, 4))
    assert.notThat(enemigoDentro.comprobarLimiteMapa())
  }

  test "23. jefe final posee 10 vidas de resistencia inicial" {
    jefe.vidas(10)
    assert.equals(10, jefe.vidas())
  }

  test "24. jefe final actualiza coordenadas al ejecutar su rutina de movimiento" {
    jefe.position(game.at(3, 3))
    const posInicial = jefe.position()
    jefe.movimiento()
    assert.notEquals(posInicial, jefe.position())
  }
}

describe "Módulo 3: Proyectiles y Double Dispatch - Colisiones e Impactos" {

  test "25. proyectil aliado se inicializa con daño y posición válidos" {
    const proyectil = new Proyectiles(position = game.at(5, 2), danio = 1)
    assert.equals(1, proyectil.danio())
    assert.equals(game.at(5, 2), proyectil.position())
  }

  test "26. proyectil aliado avanza verticalmente hacia arriba" {
    const proyectil = new Proyectiles(position = game.at(5, 2), danio = 1)
    proyectil.avanzar()
    assert.equals(game.at(5, 2.5), proyectil.position())
  }

  test "27. proyectil enemigo avanza verticalmente hacia abajo" {
    const proyectilEnemigo = new ProyectilEnemigo(position = game.at(5, 5), danio = 1)
    proyectilEnemigo.avanzar()
    assert.equals(game.at(5, 4.5), proyectilEnemigo.position())
  }

  test "28. proyectil aliado impacta enemigo y le reduce la vida (Double Dispatch)" {
    const enemigo = new Enemigo(vidas = 3, position = game.at(5, 5))
    const proyectil = new Proyectiles(position = game.at(5, 5), danio = 1)
    proyectil.interactuarConEnemigo(enemigo)
    assert.equals(2, enemigo.vidas())
  }

  test "29. proyectil aliado no daña al propio jugador al tocarlo" {
    jugador.inmune(false)
    jugador.vidas(3)
    const proyectil = new Proyectiles(position = jugador.position(), danio = 1)
    proyectil.interactuarConJugador(jugador)
    assert.equals(3, jugador.vidas())
  }

  test "30. proyectil enemigo daña al jugador al impactar" {
    jugador.inmune(false)
    jugador.vidas(3)
    const proyectilEnemigo = new ProyectilEnemigo(position = jugador.position(), danio = 1)
    proyectilEnemigo.interactuarConJugador(jugador)
    assert.equals(2, jugador.vidas())
  }

  test "31. proyectil enemigo no daña a otros enemigos aliados" {
    const enemigo = new Enemigo(vidas = 2, position = game.at(5, 5))
    const proyectilEnemigo = new ProyectilEnemigo(position = game.at(5, 5), danio = 1)
    proyectilEnemigo.interactuarConEnemigo(enemigo)
    assert.equals(2, enemigo.vidas())
  }

  test "32. colisión frontal bala con bala anula y remueve ambos proyectiles" {
    const p1 = new Proyectiles(position = game.at(4, 4), danio = 1)
    const p2 = new ProyectilEnemigo(position = game.at(4, 4), danio = 1)
    p1.interactuarConProyectilRival(p2)
    assert.equals(game.at(-100, -100), p1.position())
    assert.equals(game.at(-100, -100), p2.position())
  }

  test "33. proyectil aliado detecta salida de pantalla por el borde superior" {
    const proyectilFuera = new Proyectiles(position = game.at(5, game.height() + 1), danio = 1)
    proyectilFuera.comprobarLimiteMapa()
    assert.equals(game.at(-100, -100), proyectilFuera.position())
  }

  test "34. proyectil enemigo detecta salida de pantalla por el borde inferior" {
    const proyectilFuera = new ProyectilEnemigo(position = game.at(5, -1), danio = 1)
    proyectilFuera.comprobarLimiteMapa()
    assert.equals(game.at(-100, -100), proyectilFuera.position())
  }

  test "35. jefe final posee significativamente mayor resistencia que enemigos pesados" {
    const pesado = new EnemigoPesado(position = game.at(0, 0))
    jefe.vidas(10)
    assert.that(jefe.vidas() > pesado.vidas())
  }
}
describe "Módulo 4: Nivel 2 - Bombarderos Explosivos, Proyectiles Direccionales y Jefe Final" {

  test "36. bombardero pesado inicia con 2 vidas y sprite explosivo carmesí" {
    const bombardero = new EnemigoPesadoExplosivo(position = game.at(2, 2))
    assert.equals(2, bombardero.vidas())
    assert.equals("enemigoExplosivo.png", bombardero.image())
  }

  test "37. proyectil direccional aplica correctamente el vector de avance en cono" {
    const pDiagonal = new ProyectilDireccional(position = game.at(5, 5), danio = 1, dirX = 0.3, dirY = -0.5)
    pDiagonal.avanzar()
    assert.equals(game.at(5.3, 4.5), pDiagonal.position())
  }

  test "38. proyectil explosivo conmuta sprite de parpadeo antes de detonar" {
    const bomba = new ProyectilExplosivo(position = game.at(4, 6), danio = 1)
    bomba.avanzar()
    assert.equals("proyectilBombaBlink.png", bomba.image())
  }

  test "39. jefe de nivel 2 inicia con 16 vidas y estado de furia desactivado" {
    jefeNivel2.vidas(16)
    jefeNivel2.enFuria(false)
    assert.equals(16, jefeNivel2.vidas())
    assert.notThat(jefeNivel2.enFuria())
    assert.equals("jefeNivel2.png", jefeNivel2.image())
  }

  test "40. jefe de nivel 2 activa Fase de Furia al reducirse su salud al 50%" {
    jefeNivel2.vidas(16)
    jefeNivel2.enFuria(false)
    jefeNivel2.image("jefeNivel2.png")
    jefeNivel2.recibirDanio(8) // Baja a 8 vidas
    assert.that(jefeNivel2.enFuria())
    assert.equals("jefeNivel2Furia.png", jefeNivel2.image())
  }
}
